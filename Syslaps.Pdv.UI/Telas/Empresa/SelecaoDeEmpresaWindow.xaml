<Window x:Class="Syslaps.Pdv.UI.Telas.Empresa.SelecaoDeEmpresaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Seleção de Empresa" Height="350" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="Selecione a empresa:" Margin="0,0,0,5" FontSize="14" />
        <Border DockPanel.Dock="Bottom" Height="48" Margin="0,5,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="BtnConfirmar" IsDefault="True" Click="BtnConfirmar_OnClick" Margin="0,0,5,0" Content="_Confirmar" Width="98" />
                <Button IsCancel="True" Content="_Cancelar" Width="76"/>
            </StackPanel>
        </Border>
        <ListBox x:Name="LstEmpresas" DisplayMemberPath="RazaoSocial" MouseDoubleClick="LstEmpresas_OnMouseDoubleClick" FontSize="14" />
    </DockPanel>
</Window>
