<Window x:Class="Syslaps.Pdv.UI.Telas.FormaPagamento.FormaPagamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:entity="clr-namespace:Syslaps.Pdv.Entity;assembly=Syslaps.Pdv.Entity"
        xmlns:formaPagamento="clr-namespace:Syslaps.Pdv.UI.Telas.FormaPagamento"
        mc:Ignorable="d"
        Title="Formas de Pagamento" Height="620" Width="460" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Height="48" Margin="0,5,10,5">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="BtnGravar" IsDefault="True" Command="{Binding SalvarFormasDePagamentoCommand}" Margin="0,0,5,0" Content="_Gravar" Width="98" />
                <Button IsCancel="True" Content="_Fechar" Width="76"/>
            </StackPanel>
        </Border>
        <GroupBox Header="  Formas de Pagamento Aceitas  " Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GruposDeFormasDePagamento}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type formaPagamento:GrupoFormaPagamento}">
                            <GroupBox Header="{Binding Categoria}" Margin="5,5,5,0" FontWeight="Bold">
                                <ItemsControl ItemsSource="{Binding Itens}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="entity:TipoPagamento">
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <CheckBox IsChecked="{Binding Habilitada}" Width="30" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </DockPanel>
</Window>
